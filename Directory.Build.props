<Project>
  <PropertyGroup>
    <!-- 唯一的版本号来源：Nix 包版本和 GET / 返回的 version 都从这里来。改了引擎行为就 bump -->
    <Version>0.7.7</Version>
    <!-- 本地同时编 net10/net11 做性能对比；Nix 构建只有 SDK 10，用 -p:SnakeTargetFrameworks=net10.0 覆盖 -->
    <SnakeTargetFrameworks Condition="'$(SnakeTargetFrameworks)' == ''">net10.0;net11.0</SnakeTargetFrameworks>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- 编译器警告当 lint：3390 文档注释格式，1182 未使用的变量，3560 不改字段的 { x with }；全部当错误 -->
    <WarnOn>3390;1182;3560;$(WarnOn)</WarnOn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
