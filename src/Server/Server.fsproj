<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- F# 9 nullness checking: API fields the engine may omit are `T | null` (see Api.fs) -->
    <Nullable>enable</Nullable>
    <WarningsAsErrors>FS3261</WarningsAsErrors>
    <TargetFrameworks>$(SnakeTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Snake.Server</RootNamespace>
    <AssemblyName>snake-server</AssemblyName>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Api.fs" />
    <Compile Include="Clock.fs" />
    <Compile Include="Sessions.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Engine/Engine.fsproj" />
  </ItemGroup>

</Project>
