<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>$(SnakeTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Snake.Server</RootNamespace>
    <AssemblyName>snake-server</AssemblyName>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Api.fs" />
    <Compile Include="Clock.fs" />
    <Compile Include="Sessions.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Engine/Engine.fsproj" />
  </ItemGroup>

</Project>
